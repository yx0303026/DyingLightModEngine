<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>2</ID>
      <Description>"实验：强制关闭唾液 StickToSurfaces"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// 只覆盖 StickToSurfaces 参数解析处的 5 字节调用。
// 保留原有命中回调、伤害和特效链，仅把该字段的解析结果强制设为 false。
assert(gamedll_x64_rwdi.dll+73C1A4,E8 A7 02 BA 00)
gamedll_x64_rwdi.dll+73C1A4:
  xor eax,eax
  nop
  nop
  nop

[DISABLE]
// 恢复原始的 StickToSurfaces 参数解析调用。
assert(gamedll_x64_rwdi.dll+73C1A4,31 C0 90 90 90)
gamedll_x64_rwdi.dll+73C1A4:
  db E8 A7 02 BA 00
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
</CheatTable>
